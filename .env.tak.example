# Copy to .env.tak for local TAK development.
# Values mirror the pvarki/docker-atak-server environment plus BattleLog TAK client settings.

# BattleLog TAK observer settings
TAK_ENABLED=true
TAK_HOST=takserver_config
TAK_TLS_SERVERNAME=takserver
TAK_STREAM_PORT=8089
TAK_STREAM_TLS=true
TAK_REJECT_UNAUTHORIZED=true
# `scripts/tak/generate-local-client.sh` updates these local client cert values in .env.tak.
TAK_CLIENT_CERT_PATH=/tak/certs/files/battlelog.pem
TAK_CLIENT_KEY_PATH=/tak/certs/files/battlelog.key
TAK_CLIENT_KEY_PASSWORD=atakatak
TAK_CLIENT_P12_PATH=/tak/certs/files/battlelog.p12
TAK_CLIENT_P12_PASSWORD=atakatak
TAK_CA_PATH=/tak/certs/files/ca.pem
TAK_MARKER_TTL_SECONDS=600
TAK_RECONNECT_MS=5000
TAK_PUBLISH_STALE_SECONDS=31536000
TAK_DB_POLL_ENABLED=true
TAK_DB_HOST=takdb
TAK_DB_PORT=5432
TAK_DB_NAME=cot
TAK_DB_USER=martiuser
TAK_DB_PASSWORD=tak-local-postgres
TAK_DB_POLL_MS=1000
TAK_DB_QUERY_LIMIT=1000

# TAK image settings
PVARKI_DOCKER_REPO=ghcr.io/
TAK_RELEASE=5.6-RELEASE-20
DOCKER_TAG_EXTRA=

# Phone/LAN published ports
TAK_CLIENT_PORT=8089
TAK_WEB_PORT=8443
TAK_FEDERATION_PORT=8444
TAK_CERT_PORT=8446
TAK_FED_V1_PORT=9000
TAK_FED_V2_PORT=9001

# TAK server mission package / cert configuration
TAK_SERVER_ADDRESS=127.0.0.1
TAK_SERVER_NAME=BattleLog Local TAK
POSTGRES_PASSWORD=tak-local-postgres
ADMIN_CERT_PASS=atakatak
TAKSERVER_CERT_PASS=atakatak
COUNTRY=FI
CA_NAME=BattleLogLocalCA
CA_PASS=atakatak
STATE=Uusimaa
CITY=Helsinki
ORGANIZATION=BattleLog
ORGANIZATIONAL_UNIT=LocalDev
ADMIN_CERT_NAME=admin

# Values that normally stay as defaults
POSTGRES_DB=cot
POSTGRES_USER=martiuser
POSTGRES_ADDRESS=takdb
POSTGRES_SUPERUSER=martiuser
POSTGRES_SUPER_PASSWORD=tak-local-postgres
LOGGING_JSON_ENABLED=true
LOGGING_CONFIG=/opt/tak/logging-restrictsize.xml
